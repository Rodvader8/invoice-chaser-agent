{
  "name": "invoice-chaser-agent",
  "version": "0.1.0",
  "description": "An agent that drafts overdue-invoice reminders for an Australian trade business; code computes the money, a person approves, sending is lost-reply safe.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "eval": "tsx evals/run.ts",
    "eval:break": "node --import tsx scripts/break-check.ts",
    "demo": "tsx src/cli/demo.ts",
    "serve": "tsx src/cli/serve.ts",
    "mcp": "tsx src/cli/mcp.ts",
    "standins": "tsx src/cli/standins.ts",
    "cdk:synth": "cd infra && CDK_DISABLE_CLI_TELEMETRY=true AWS_EC2_METADATA_DISABLED=true cdk synth --no-notices --quiet",
    "dynamodb:start": "docker run -d --rm --name invoice-chaser-dynamodb -p 127.0.0.1:8000:8000 amazon/dynamodb-local@sha256:6ada631ec7aa5fc83446855eb17233e3dad184fec47477e8140c6c569cfe0c86",
    "dynamodb:stop": "docker stop invoice-chaser-dynamodb",
    "test:dynamodb": "REQUIRE_DYNAMODB=1 vitest run",
    "infra:drift": "node --import tsx scripts/infra-drift-check.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1175.0",
    "@aws-sdk/client-ssm": "3.1175.0",
    "@aws-sdk/lib-dynamodb": "3.1175.0",
    "@langchain/core": "1.4.2",
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint": "1.2.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "aws-cdk": "2.1149.0",
    "aws-cdk-lib": "2.278.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
